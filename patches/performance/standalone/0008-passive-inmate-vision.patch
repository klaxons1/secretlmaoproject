+			// Passive inmates neither use 'found' nor have canSee side effects.
+			// Guards must still scan: they can discover digged walls.
+			if (guard || attack) {
+				for (int i = 1; i < n; ++i) {
+					NPC other = chars[i];
+					if (other == null || other == this || other.guard || other.health <= 0 || !canSee(other)) {
+						continue;
+					}
+
+					if (guard) {
+						// attack if inmate is fighting
+						if (other.fighting != 0) {
+							aiState = AI_ATTACK;
+							chaseTarget = other;
+							aiWaitTimer = 0;
+							StringBuffer sb = Game.stringBuffer;
+							sb.setLength(0);
+							heat(sb.append("Oi! ").append(other.name).toString(), 0);
+							break;
+						}
+					} else if (inmate && other.inmate) {
+						// attack someone in random interval if not busy
+						found = true;
+						if (attack && rng.nextInt(30) == 0) {
