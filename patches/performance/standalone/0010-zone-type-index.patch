 	// region Map zones
 
 	int[] zones; // int[5] {count, [x,y,x1,x2,type], ...}
+	private int[] indexedZones;
+	private short[] firstZoneByType, nextZoneOfType;
+
+
+	// Zone data is immutable after load; a new map replaces the zones array.
+	private void ensureZoneIndex() {
+		if (indexedZones == zones) return;
+		short[] first = new short[ZONE_SAFE + 1];
+		short[] next = new short[zones[0]];
+		for (int i = 0; i < first.length; ++i) first[i] = -1;
+		for (int i = next.length - 1; i >= 0; --i) {
+			int type = zones[i * 5 + 5];
+			next[i] = -1;
+			if (type >= 0 && type < first.length) {
+				next[i] = first[type];
+				first[type] = (short) i;
+			}
+		}
+		firstZoneByType = first;
+		nextZoneOfType = next;
+		indexedZones = zones;
+	}
 
 	boolean isInZone(int x, int y, int zone) {
